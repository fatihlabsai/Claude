; Engine configuration file.
config_version=5

[application]

config/name="Çölde Hayatta Kalma"
config/description="Godot 4 ile çölde hayatta kalma oyunu."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.96, 0.82, 0.58, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

driver/enable_input=false

[autoload]

Sfx="*res://scripts/sfx.gd"
Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=0

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/standalone_ternary=0
